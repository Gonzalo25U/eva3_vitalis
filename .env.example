# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio.

# Key de OpenRouter (https://openrouter.ai/keys). Obligatoria.
LLM_API_KEY=sk-or-v1-reemplazar-por-tu-key

# Endpoint compatible con la API de OpenAI. Opcional: si se omite, se usa OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Nota: el modelo (openai/gpt-6-luna) se fija dentro del notebook,
# para que la v1 y la v2 se midan con el mismo modelo.
